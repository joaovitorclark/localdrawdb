Table staging.erp_pedido {
  pedido_id number(19) [pk, note: 'Identificador natural do pedido no ERP']
  conta_id varchar2(32)
  loja_codigo varchar2(16)
  moeda varchar2(3)
  status_pedido varchar2(32)
  valor_bruto number(18,2)
  criado_em timestamp
}

Table staging.erp_pedido_item {
  pedido_id number(19) [not null]
  seq_item number(5) [not null]
  sku varchar2(32)
  quantidade number(10)
  preco_unitario number(18,4)
  desconto_pct number(5,2)
  indexes {
    (pedido_id, seq_item) [pk]
  }
}

Table staging.crm_conta {
  conta_id varchar2(32) [pk]
  razao_social varchar2(255)
  segmento varchar2(64)
  regiao varchar2(64)
  pais varchar2(2)
}

Table staging.crm_contato {
  contato_id varchar2(32) [pk]
  conta_id varchar2(32)
  nome varchar2(255)
  email varchar2(255)
  cargo varchar2(128)
}

Table staging.catalogo_produto {
  sku varchar2(32) [pk]
  nome_produto varchar2(255)
  categoria_n1 varchar2(64)
  categoria_n2 varchar2(64)
  preco_lista number(18,2)
  ativo number(1)
}

Table staging.gateway_pagamento {
  txn_id varchar2(32) [pk]
  pedido_id number(19)
  valor number(18,2)
  forma_pagamento varchar2(32)
  status_pagamento varchar2(32)
  pago_em timestamp
}

Table staging.web_evento {
  evento_id varchar2(32) [pk]
  sessao_id varchar2(64)
  email_contato varchar2(255)
  tipo_evento varchar2(64)
  url_pagina varchar2(512)
  ocorrido_em timestamp
}

Table silver.dim_conta {
  sk_conta number(19) [pk]
  conta_natural_id varchar2(32)
  razao_social varchar2(255)
  segmento varchar2(64)
  regiao varchar2(64)
  vigente number(1)
  valido_de timestamp
  valido_ate timestamp
  dt_carga_silver timestamp
}

Table silver.dim_produto {
  sk_produto number(19) [pk]
  sku varchar2(32)
  nome_produto varchar2(255)
  categoria_n1 varchar2(64)
  categoria_n2 varchar2(64)
  preco_lista number(18,2)
  dt_carga_silver timestamp
}

Table silver.dim_loja {
  sk_loja number(5) [pk]
  codigo_loja varchar2(16)
  nome_loja varchar2(128)
  uf varchar2(2)
}

Table silver.dim_forma_pagamento {
  sk_forma_pagamento number(5) [pk]
  codigo varchar2(32)
  descricao varchar2(128)
}

Table silver.dim_calendario {
  sk_data number(8) [pk]
  data_ref date
  ano number(4)
  mes number(2)
  dia number(2)
}

Table silver.dim_contato {
  sk_contato number(19) [pk]
  contato_natural_id varchar2(32)
  sk_conta number(19)
  nome varchar2(255)
  email varchar2(255)
}

Table silver.fato_pedido {
  sk_pedido number(19) [pk]
  pedido_natural_id number(19)
  sk_conta number(19)
  sk_loja number(5)
  sk_data number(8)
  valor_bruto number(18,2)
  status_pedido varchar2(32)
  dt_carga_silver timestamp
}

Table silver.fato_pedido_item {
  sk_item number(19) [pk]
  sk_pedido number(19)
  seq_item number(5)
  sk_produto number(19)
  quantidade number(10)
  preco_unitario number(18,4)
  desconto_pct number(5,2)
  attr_001 varchar2(64)
  attr_002 varchar2(64)
  attr_003 varchar2(64)
  attr_004 varchar2(64)
  attr_005 varchar2(64)
  attr_006 varchar2(64)
  attr_007 varchar2(64)
  attr_008 varchar2(64)
  attr_009 varchar2(64)
  attr_010 varchar2(64)
  attr_011 varchar2(64)
  attr_012 varchar2(64)
  attr_013 varchar2(64)
  attr_014 varchar2(64)
  attr_015 varchar2(64)
  attr_016 varchar2(64)
  attr_017 varchar2(64)
  attr_018 varchar2(64)
  attr_019 varchar2(64)
  attr_020 varchar2(64)
  attr_021 varchar2(64)
  attr_022 varchar2(64)
  attr_023 varchar2(64)
  attr_024 varchar2(64)
  attr_025 varchar2(64)
  attr_026 varchar2(64)
  attr_027 varchar2(64)
  attr_028 varchar2(64)
  attr_029 varchar2(64)
  attr_030 varchar2(64)
  attr_031 varchar2(64)
  attr_032 varchar2(64)
  attr_033 varchar2(64)
  attr_034 varchar2(64)
  attr_035 varchar2(64)
  attr_036 varchar2(64)
  attr_037 varchar2(64)
  attr_038 varchar2(64)
  attr_039 varchar2(64)
  attr_040 varchar2(64)
  attr_041 varchar2(64)
  attr_042 varchar2(64)
  attr_043 varchar2(64)
  attr_044 varchar2(64)
  attr_045 varchar2(64)
  attr_046 varchar2(64)
  attr_047 varchar2(64)
  attr_048 varchar2(64)
  dt_carga_silver timestamp
}

Table silver.fato_pagamento {
  sk_pagamento number(19) [pk]
  txn_natural_id varchar2(32)
  sk_pedido number(19)
  sk_forma_pagamento number(5)
  valor number(18,2)
  status_pagamento varchar2(32)
  dt_carga_silver timestamp
}

Table silver.fato_evento_marketing {
  sk_evento number(19) [pk]
  evento_natural_id varchar2(32)
  sk_contato number(19)
  tipo_evento varchar2(64)
  url_pagina varchar2(512)
  ocorrido_em timestamp
  dt_carga_silver timestamp
}

Table silver.bridge_conta_contato {
  sk_conta number(19) [not null]
  sk_contato number(19) [not null]
  papel varchar2(64)
  dt_carga_silver timestamp
  indexes {
    (sk_conta, sk_contato) [pk]
  }
}

Table gold.kpi_vendas_dia {
  sk_data number(8) [pk]
  total_pedidos number(10)
  receita_bruta number(18,2)
  ticket_medio number(18,2)
  dt_carga_gold timestamp
}

Table gold.fato_cliente_mes {
  sk_conta number(19) [not null]
  ano_mes number(6) [not null]
  receita number(18,2)
  qtd_pedidos number(10)
  valor_pago number(18,2)
  dt_carga_gold timestamp
  indexes {
    (sk_conta, ano_mes) [pk]
  }
}

Table gold.report_executivo {
  periodo date [not null]
  regiao varchar2(64) [not null]
  segmento varchar2(64)
  receita_consolidada number(18,2)
  pedidos number(10)
  indexes {
    (periodo, regiao) [pk]
  }
}

Ref: staging.erp_pedido.conta_id > staging.crm_conta.conta_id
Ref: staging.erp_pedido_item.pedido_id > staging.erp_pedido.pedido_id
Ref: staging.erp_pedido_item.sku > staging.catalogo_produto.sku
Ref: staging.crm_contato.conta_id > staging.crm_conta.conta_id
Ref: staging.gateway_pagamento.pedido_id > staging.erp_pedido.pedido_id
Ref: silver.dim_conta.conta_natural_id > staging.crm_conta.conta_id
Ref: silver.dim_produto.sku > staging.catalogo_produto.sku
Ref: silver.dim_contato.sk_conta > silver.dim_conta.sk_conta
Ref: silver.fato_pedido.sk_conta > silver.dim_conta.sk_conta
Ref: silver.fato_pedido.sk_loja > silver.dim_loja.sk_loja
Ref: silver.fato_pedido.sk_data > silver.dim_calendario.sk_data
Ref: silver.fato_pedido_item.sk_pedido > silver.fato_pedido.sk_pedido
Ref: silver.fato_pedido_item.sk_produto > silver.dim_produto.sk_produto
Ref: silver.fato_pagamento.sk_pedido > silver.fato_pedido.sk_pedido
Ref: silver.fato_pagamento.sk_forma_pagamento > silver.dim_forma_pagamento.sk_forma_pagamento
Ref: silver.fato_evento_marketing.sk_contato > silver.dim_contato.sk_contato
Ref: silver.bridge_conta_contato.sk_conta > silver.dim_conta.sk_conta
Ref: silver.bridge_conta_contato.sk_contato > silver.dim_contato.sk_contato
Ref: gold.fato_cliente_mes.sk_conta > silver.dim_conta.sk_conta

Lineage {
  silver.dim_conta < staging.crm_conta
  silver.dim_produto < staging.catalogo_produto
  silver.dim_contato < staging.crm_contato
  silver.fato_pedido < staging.erp_pedido, staging.gateway_pagamento
  silver.fato_pedido_item < staging.erp_pedido_item
  silver.fato_pagamento < staging.gateway_pagamento
  silver.fato_evento_marketing < staging.web_evento
  gold.kpi_vendas_dia < silver.fato_pedido
  gold.fato_cliente_mes < silver.fato_pedido, silver.fato_pagamento
  gold.report_executivo < gold.kpi_vendas_dia, gold.fato_cliente_mes
}

LineageFields {
  silver.dim_conta.conta_natural_id < staging.crm_conta.conta_id
  silver.dim_conta.razao_social < staging.crm_conta.razao_social
  silver.dim_conta.segmento < staging.crm_conta.segmento
  silver.dim_conta.regiao < staging.crm_conta.regiao
  silver.dim_produto.sku < staging.catalogo_produto.sku
  silver.dim_produto.nome_produto < staging.catalogo_produto.nome_produto
  silver.dim_produto.preco_lista < staging.catalogo_produto.preco_lista
  silver.dim_contato.contato_natural_id < staging.crm_contato.contato_id
  silver.dim_contato.nome < staging.crm_contato.nome
  silver.dim_contato.email < staging.crm_contato.email
  silver.fato_pedido.pedido_natural_id < staging.erp_pedido.pedido_id
  silver.fato_pedido.valor_bruto < staging.erp_pedido.valor_bruto
  silver.fato_pedido.status_pedido < staging.erp_pedido.status_pedido
  silver.fato_pedido_item.seq_item < staging.erp_pedido_item.seq_item
  silver.fato_pedido_item.quantidade < staging.erp_pedido_item.quantidade
  silver.fato_pedido_item.preco_unitario < staging.erp_pedido_item.preco_unitario
  silver.fato_pedido_item.desconto_pct < staging.erp_pedido_item.desconto_pct
  silver.fato_pagamento.txn_natural_id < staging.gateway_pagamento.txn_id
  silver.fato_pagamento.valor < staging.gateway_pagamento.valor
  silver.fato_pagamento.status_pagamento < staging.gateway_pagamento.status_pagamento
  silver.fato_evento_marketing.evento_natural_id < staging.web_evento.evento_id
  silver.fato_evento_marketing.tipo_evento < staging.web_evento.tipo_evento
  silver.fato_evento_marketing.url_pagina < staging.web_evento.url_pagina
  gold.kpi_vendas_dia.receita_bruta < silver.fato_pedido.valor_bruto [note: 'SUM(valor_bruto) por dia']
  gold.kpi_vendas_dia.total_pedidos < silver.fato_pedido.sk_pedido [note: 'COUNT DISTINCT']
  gold.report_executivo.receita_consolidada < gold.kpi_vendas_dia.receita_bruta [note: 'rollup regional']
  gold.report_executivo.pedidos < gold.kpi_vendas_dia.total_pedidos
}

TableGroup ingestao_oracle {
  staging.erp_pedido
  staging.erp_pedido_item
  staging.crm_conta
  staging.crm_contato
  staging.catalogo_produto
  staging.gateway_pagamento
}
TableGroup ingestao_web {
  staging.web_evento
}
TableGroup dimensoes {
  silver.dim_conta
  silver.dim_produto
  silver.dim_loja
  silver.dim_forma_pagamento
  silver.dim_calendario
  silver.dim_contato
}
TableGroup fatos {
  silver.fato_pedido
  silver.fato_pedido_item
  silver.fato_pagamento
  silver.fato_evento_marketing
}
TableGroup bridge {
  silver.bridge_conta_contato
}
TableGroup agregados {
  gold.kpi_vendas_dia
  gold.fato_cliente_mes
}
TableGroup reports {
  gold.report_executivo
}

LayerGroup bronze [color: #b08d57] {
  staging.erp_pedido
  staging.erp_pedido_item
  staging.crm_conta
  staging.crm_contato
  staging.catalogo_produto
  staging.gateway_pagamento
  staging.web_evento
}
LayerGroup prata [color: #9ca3af] {
  silver.dim_conta
  silver.dim_produto
  silver.dim_loja
  silver.dim_forma_pagamento
  silver.dim_calendario
  silver.dim_contato
  silver.fato_pedido
  silver.fato_pedido_item
  silver.fato_pagamento
  silver.fato_evento_marketing
  silver.bridge_conta_contato
}
LayerGroup ouro [color: #d4af37] {
  gold.kpi_vendas_dia
  gold.fato_cliente_mes
  gold.report_executivo
}

